<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Every parameter below has a field in Réglages -> Freemoov AI Livechat
         (`res_config_settings.py`), and the test suite keeps it that way: a
         knob nobody can reach from the backend is a knob nobody turns.

         The switches are read as `value == "True"` everywhere in this module,
         never as `bool(value)` — which is also why the settings screen reads
         them by hand: the framework's own reader would show "False" as
         ticked. -->
    <record id="param_enabled" model="ir.config_parameter">
        <field name="key">freemoov_livechat_ai.enabled</field>
        <field name="value">False</field>
    </record>
    <record id="param_dry_run" model="ir.config_parameter">
        <field name="key">freemoov_livechat_ai.dry_run</field>
        <field name="value">True</field>
    </record>
    <record id="param_knowledge_enabled" model="ir.config_parameter">
        <field name="key">freemoov_livechat_ai.knowledge_enabled</field>
        <field name="value">False</field>
    </record>
    <record id="param_model" model="ir.config_parameter">
        <field name="key">freemoov_livechat_ai.model</field>
        <field name="value">claude-haiku-4-5-20251001</field>
    </record>
    <record id="param_max_tokens" model="ir.config_parameter">
        <field name="key">freemoov_livechat_ai.max_tokens</field>
        <field name="value">400</field>
    </record>
    <record id="param_verification_test_mode" model="ir.config_parameter">
        <field name="key">freemoov_livechat_ai.verification_test_mode</field>
        <field name="value">False</field>
    </record>
    <record id="param_repair_tool_enabled" model="ir.config_parameter">
        <field name="key">freemoov_livechat_ai.repair_tool_enabled</field>
        <field name="value">False</field>
    </record>
    <record id="param_rate_limit" model="ir.config_parameter">
        <field name="key">freemoov_livechat_ai.rate_limit_per_min</field>
        <field name="value">20</field>
    </record>
    <record id="param_conversation_token_budget" model="ir.config_parameter">
        <field name="key">freemoov_livechat_ai.conversation_token_budget</field>
        <field name="value">50000</field>
    </record>
    <record id="param_client_timeout" model="ir.config_parameter">
        <field name="key">freemoov_livechat_ai.client_timeout</field>
        <field name="value">15</field>
    </record>
    <!-- Empty token: the HTTP tool API answers 403 until one is set. -->
    <record id="param_api_token" model="ir.config_parameter">
        <field name="key">freemoov_livechat_ai.api_token</field>
        <field name="value"></field>
    </record>
    <record id="param_api_rate_per_min" model="ir.config_parameter">
        <field name="key">freemoov_livechat_ai.api_rate_per_min</field>
        <field name="value">60</field>
    </record>
</odoo>
