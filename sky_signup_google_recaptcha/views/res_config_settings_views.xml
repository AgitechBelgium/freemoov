<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inherit_google_recaptcha_res_config_settings_view" model="ir.ui.view">
        <field name="name">inherit.google.recaptcha.res.config.settings.view</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="35"/>
        <field name="inherit_id" ref="google_recaptcha.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='website_recaptcha_settings']" position="after">
                <div class="col-12 col-lg-12 o_setting_box mt-4" id="sky_recaptcha">
                    <div class="o_setting_left_pane">
                        <field name="enable_recaptcha_validation"/>
                    </div>
                    <div class="o_setting_right_pane" id="recaptcha_validation">
                        <label for="enable_recaptcha_validation"/>
                        <div class="text-muted">
                            Enable Google reCAPTCHA validation for the signup form.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
