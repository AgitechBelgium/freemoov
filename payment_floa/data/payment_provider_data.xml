<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
          Provider and payment method are seeded so Odoo knows about FLOA, but
          credentials are NEVER committed. The provider stays in 'disabled'
          state until an admin fills client_id / client_secret / hmac_key in
          Settings > Payment Providers > FLOA Pay and switches the state.

          For local development against the sandbox, install the module with
          the load-demo flag to also load payment_provider_sandbox_demo.xml.
        -->
        <record id="payment_method_floa" model="payment.method">
            <field name="name">Floa Pay (3x sans frais)</field>
            <field name="code">floa</field>
            <field name="active">True</field>
            <field name="image" type="base64" file="payment_floa/static/description/icon.png"/>
        </record>

        <record id="payment_provider_floa" model="payment.provider">
            <field name="name">FLOA Pay — 3x sans frais</field>
            <field name="code">floa</field>
            <field name="state">disabled</field>
            <field name="is_published">False</field>
            <field name="redirect_form_view_id" ref="redirect_form"/>
            <field name="payment_method_ids" eval="[(4, ref('payment_method_floa'))]"/>
            <field name="floa_product_code">BC3XFBE</field>
        </record>
    </data>
</odoo>
