<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Backend: surface FLOA-specific customer fields on the partner form -->
    <record id="view_partner_form_floa" model="ir.ui.view">
        <field name="name">res.partner.form.floa</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="before">
                <page string="FLOA Pay" name="floa">
                    <group>
                        <group string="Paiement fractionné">
                            <field name="floa_birth_date"/>
                            <field name="floa_birth_country_id"
                                   options="{'no_create': True, 'no_quick_create': True}"/>
                            <field name="floa_national_number"
                                   placeholder="XX.XX.XX-XXX.XX"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
