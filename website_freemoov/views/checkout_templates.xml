<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- 1. STEPPER / Wizard Checkout Override                        -->
    <!-- ============================================================ -->
    <!-- Template autonome qui rend le stepper 3 cercles numérotés.
         Détermine l'étape courante à partir de xmlid (passé par checkout_layout).
         Le SCSS .fm-stepper__step::before dessine le connecteur — pas de bar
         DOM entre les steps. -->
    <template id="fm_stepper" name="Freemoov Checkout Stepper">
        <t t-set="_is_cart" t-value="xmlid == 'website_sale.cart'"/>
        <t t-set="_is_info" t-value="xmlid in ('website_sale.checkout', 'website_sale.address')"/>
        <t t-set="_is_payment" t-value="xmlid == 'website_sale.payment'"/>
        <t t-set="_is_confirm" t-value="xmlid in ('website_sale.confirmation', 'website_sale.payment_confirmation')"/>
        <div class="fm-stepper" role="navigation" aria-label="Étapes de commande">
            <!-- Step 1: Panier -->
            <a t-attf-class="fm-stepper__step #{_is_cart and 'fm-stepper__step--active' or 'fm-stepper__step--completed'}" href="/shop/cart">
                <div class="fm-stepper__circle">
                    <t t-if="_is_cart">1</t>
                    <t t-else=""><i class="fa fa-check"/></t>
                </div>
                <div class="fm-stepper__label">Panier</div>
            </a>
            <!-- Step 2: Informations / Paiement regroupés -->
            <a t-attf-class="fm-stepper__step #{(_is_info or _is_payment) and 'fm-stepper__step--active' or _is_confirm and 'fm-stepper__step--completed' or 'fm-stepper__step--disabled'}" t-att-href="not _is_cart and '/shop/checkout' or '#'">
                <div class="fm-stepper__circle">
                    <t t-if="_is_confirm"><i class="fa fa-check"/></t>
                    <t t-else="">2</t>
                </div>
                <div class="fm-stepper__label">Informations</div>
            </a>
            <!-- Step 3: Confirmation -->
            <div t-attf-class="fm-stepper__step #{_is_confirm and 'fm-stepper__step--active' or 'fm-stepper__step--disabled'}">
                <div class="fm-stepper__circle">3</div>
                <div class="fm-stepper__label">Confirmation</div>
            </div>
        </div>
    </template>

    <!-- Redirige le t-call "website_sale.wizard_checkout" de checkout_layout
         vers notre stepper custom — pour /shop/cart, /shop/checkout,
         /shop/address, /shop/payment, /shop/confirmation -->
    <template id="fm_inject_stepper_in_layout"
              inherit_id="website_sale.checkout_layout"
              name="Freemoov inject custom stepper in checkout layout">
        <xpath expr="//t[@t-call='website_sale.wizard_checkout']" position="replace">
            <t t-call="website_freemoov.fm_stepper"/>
        </xpath>
    </template>

    <!-- ============================================================ -->
    <!-- 2. SIDEBAR "Achat en toute confiance" — enrichit o_total_card  -->
    <!-- ============================================================ -->
    <template id="fm_cart_sidebar_enhance"
              inherit_id="website_sale.checkout_layout"
              name="Freemoov enrich cart sidebar with reassurance">
        <!-- Ajoute un titre au-dessus des totaux -->
        <xpath expr="//div[@id='o_cart_summary']//div[hasclass('card-body')]" position="inside">
            <!-- Ce noeud est ajouté APRÈS tous les contenus existants (total,
                 express_checkout, navigation_buttons). Pour les mettre au-dessus,
                 on utilise position="before" sur le premier t-call ensuite. -->
        </xpath>

        <!-- Titre "Achat en toute confiance" en haut de la card -->
        <xpath expr="//div[@id='o_cart_summary']//t[@t-call='website_sale.total']" position="before">
            <div class="fm-sidebar-title">
                <i class="fa fa-shield" aria-hidden="true"/>
                <span>Achat en toute confiance</span>
            </div>
        </xpath>

        <!-- Après le bouton de navigation : progress "Le plus dur est fait" + reassurance -->
        <xpath expr="//div[@id='o_cart_summary']//t[@t-call='website_sale.navigation_buttons']" position="after">
            <div class="fm-sidebar-progress">
                <div class="fm-sidebar-progress__label">
                    Le plus dur est fait : vous avez trouvé votre bonheur !
                </div>
                <div class="fm-sidebar-progress__bar">
                    <div class="fm-sidebar-progress__fill" style="width: 50%">
                        <span class="fm-sidebar-progress__percent">50%</span>
                    </div>
                </div>
            </div>

            <div class="fm-sidebar-secure">
                <i class="fa fa-lock" aria-hidden="true"/>
                <span>PAIEMENT 100% SÉCURISÉ</span>
            </div>

            <div class="fm-sidebar-payment-methods">
                <img src="/website_freemoov/static/src/img/payment_icons.png"
                     alt="Méthodes de paiement acceptées"
                     loading="lazy"/>
            </div>

            <div class="fm-sidebar-reassurance">
                <div class="fm-sidebar-reassurance__item">
                    <i class="fa fa-truck" aria-hidden="true"/>
                    <span>Livraison Express : 24/72h</span>
                </div>
                <div class="fm-sidebar-reassurance__item">
                    <i class="fa fa-refresh" aria-hidden="true"/>
                    <span>Retour sous 30 jours</span>
                </div>
                <div class="fm-sidebar-reassurance__item">
                    <i class="fa fa-headphones" aria-hidden="true"/>
                    <span>SAV par nos specialistes</span>
                </div>
            </div>
        </xpath>
    </template>

    <!-- ============================================================ -->
    <!-- 3. Labels français — Résumé / Totaux / Boutons                -->
    <!-- ============================================================ -->
    <template id="fm_checkout_labels_fr"
              inherit_id="website_sale.checkout_layout"
              name="Freemoov French labels in checkout">
        <!-- "Order summary" → "Résumé de la commande" (accordion mobile) -->
        <xpath expr="//b[hasclass('w-100')][1]" position="replace">
            <b class="w-100">Résumé de la commande</b>
        </xpath>
    </template>

    <!-- ============================================================ -->
    <!-- 4. Fix bug JS v17 : _handleCarrierUpdateResult null-crash      -->
    <!-- ============================================================ -->
    <!-- Le JS website_sale_delivery._handleCarrierUpdateResult fait
         querySelector('#order_delivery .monetary_field') sans null-check.
         Le core v17 ne rend #order_delivery que si website_sale_order.carrier_id
         est déjà set (via cart_delivery inherit). Au premier clic carrier,
         order.carrier_id est null → #order_delivery absent → innerHTML crash.
         Override : rendre toujours #order_delivery (caché initialement si
         pas de carrier, révélé par le JS au moment où il écrit innerHTML). -->
    <template id="fm_ensure_order_delivery_dom"
              inherit_id="website_sale.total"
              name="Freemoov ensure #order_delivery always in DOM">
        <xpath expr="//tr[@id='order_total_untaxed']" position="before">
            <tr id="order_delivery"
                t-if="not website_sale_order or not website_sale_order.carrier_id"
                style="display: none;">
                <td colspan="2" class="ps-0 pt-0 pb-2 border-0 text-muted">
                    Livraison
                </td>
                <td class="text-end pe-0 pt-0 pb-2 border-0 text-muted">
                    <span class="monetary_field" style="white-space: nowrap;">0,00&#160;€</span>
                </td>
            </tr>
        </xpath>
    </template>

</odoo>
