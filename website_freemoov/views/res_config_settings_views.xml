<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_freemoov_maintenance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.freemoov.maintenance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='website_info_settings']" position="after">
                <h2>Maintenance Freemoov</h2>
                <div class="col-xs-12 row o_settings_container" id="freemoov_maintenance_settings">
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="fm_maintenance_banner_active"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="fm_maintenance_banner_active" string="Bandeau de pré-annonce"/>
                            <div class="text-muted">
                                Affiche un bandeau en haut de toutes les pages du site pour annoncer l'opération de maintenance à venir.
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="fm_maintenance_mode_active"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="fm_maintenance_mode_active" string="Mode maintenance (site fermé)"/>
                            <div class="text-muted">
                                Redirige tout visiteur non authentifié (interne) vers la page de maintenance. Les accès backoffice restent disponibles via /web.
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="fm_maintenance_start_datetime" string="Début de la maintenance"/>
                            <div class="text-muted">
                                Affiché dans le bandeau si renseigné.
                            </div>
                            <div class="content-group">
                                <field name="fm_maintenance_start_datetime"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="fm_maintenance_message" string="Message personnalisé"/>
                            <div class="text-muted">
                                Remplace le message par défaut du bandeau et de la page de maintenance.
                            </div>
                            <div class="content-group">
                                <field name="fm_maintenance_message"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
