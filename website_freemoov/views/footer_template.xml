<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<template id="footer" name="Footer Freemoov" inherit_id="website.layout" active="False">
		<xpath expr="//div[@id='footer']" position="before">
			<section class="fm-trust-bar">
				<div class="container">
					<div class="row align-items-center text-center text-white py-4">
						<div class="col-6 col-md-3 mb-3 mb-md-0">
							<div class="fm-trust-item">
								<img src="/website_freemoov/static/src/img/homepage/Group1.png"
									alt="N°1 en Belgique" class="mb-2" loading="lazy"/>
								<p class="mb-0 small"><strong>N°1 en Wallonie</strong> depuis 2019</p>
							</div>
						</div>
						<div class="col-6 col-md-3 mb-3 mb-md-0">
							<div class="fm-trust-item">
								<img src="/website_freemoov/static/src/img/homepage/Group2.png"
									alt="Avis clients" class="mb-2" loading="lazy"/>
								<p class="mb-0 small"><strong>4.8/5 sur Google</strong> — 350 avis</p>
							</div>
						</div>
						<div class="col-6 col-md-3">
							<div class="fm-trust-item">
								<img src="/website_freemoov/static/src/img/homepage/Group3.png"
									alt="Réparation" class="mb-2" loading="lazy"/>
								<p class="mb-0 small"><strong>Réparation sur place</strong> à Liège et Namur</p>
							</div>
						</div>
						<div class="col-6 col-md-3">
							<div class="fm-trust-item">
								<img src="/website_freemoov/static/src/img/homepage/Group4.png"
									alt="Conseil expert" class="mb-2" loading="lazy"/>
								<p class="mb-0 small"><strong>Conseil expert</strong> en magasin spécialisé</p>
							</div>
						</div>
					</div>
				</div>
			</section>
		</xpath>
		<xpath expr="//div[@id='footer']" position="replace">
			<div id="footer" class="fm-footer py-5">
				<div class="container">
					<div class="row">
						<!-- Brand -->
						<div class="col-lg-3 mb-4">
							<a href="/">
								<img src="/website_freemoov/static/src/img/Freemoov_RGB_Logo_negatif.png"
									alt="Freemoov" class="fm-footer-logo mb-3" loading="lazy"/>
							</a>
							<p class="fm-footer-tagline">
								Le spécialiste N°1 de la mobilité électrique en Belgique — magasins à Liège et Namur.
							</p>
							<div class="fm-footer-social">
								<a href="/website/social/instagram" target="_blank" aria-label="Instagram"><i class="fa fa-instagram"/></a>
								<a href="/website/social/facebook" target="_blank" aria-label="Facebook"><i class="fa fa-facebook"/></a>
								<a href="/website/social/linkedin" target="_blank" aria-label="LinkedIn"><i class="fa fa-linkedin"/></a>
								<a href="/website/social/youtube" target="_blank" aria-label="YouTube"><i class="fa fa-youtube-play"/></a>
							</div>
							<div class="fm-google-badge mt-3">
								<a href="https://www.google.com/maps/place/Freemoov" target="_blank"
									rel="noopener noreferrer" title="Voir nos avis Google">
									<div class="fm-badge-inner">
										<svg class="fm-google-g" viewBox="0 0 24 24" width="24" height="24" xmlns="http://www.w3.org/2000/svg">
											<path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
											<path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
											<path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
											<path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
										</svg>
										<div class="fm-badge-content">
											<div class="fm-badge-stars">
												<i class="fa fa-star"/>
												<i class="fa fa-star"/>
												<i class="fa fa-star"/>
												<i class="fa fa-star"/>
												<i class="fa fa-star-half-o"/>
												<strong>4.8</strong><span>/5</span>
											</div>
											<div class="fm-badge-count">350 avis Google</div>
										</div>
									</div>
								</a>
							</div>
						</div>

						<!-- À propos -->
						<div class="col-lg-3 mb-4">
							<div class="fm-footer-heading">À propos</div>
							<ul class="fm-footer-links list-unstyled">
								<li><a href="/about">Qui sommes-nous ?</a></li>
								<li><a href="/terms">Conditions générales</a></li>
								<li><a href="/cookie-policy">Cookies</a></li>
								<li><a href="/privacy-policy">Données personnelles</a></li>
								<li><a href="/delivery">Livraison</a></li>
								<li><a href="/garantie">Garantie</a></li>
								<li><a href="/return">Retour</a></li>
							</ul>
						</div>

						<!-- Besoin d'aide -->
						<div class="col-lg-3 mb-4">
							<div class="fm-footer-heading">Besoin d'aide ?</div>
							<ul class="fm-footer-links list-unstyled">
								<li><a href="/blog">Guide et conseil</a></li>
								<li><a href="/contactus">Contactez-nous</a></li>
								<li><a href="/magasin">Magasin</a></li>
								<li><a href="/services-atelier">Services atelier</a></li>
							</ul>
						</div>

						<!-- Contact -->
						<div class="col-lg-3 mb-4">
							<div class="fm-footer-heading">Contact</div>
							<div class="fm-contact-block">
								<div class="fm-contact-item">
									<i class="fa fa-phone"/>
									<a href="tel:+3281659166">+32 81 65 91 66</a>
								</div>
								<div class="fm-contact-hours">
									<span>10h à 18h mardi à vendredi</span><br/>
									<span>11h à 17h samedi</span>
								</div>
							</div>
							<div class="fm-contact-block mt-3">
								<div class="fm-contact-item">
									<i class="fa fa-envelope-o"/>
									<a href="/contactus">Formulaire de contact</a>
								</div>
								<div class="fm-contact-hours">
									<span>10h à 18h lundi à vendredi</span>
								</div>
							</div>
						</div>
					</div>

					<!-- Newsletter -->
					<div class="row mt-3 pt-3 fm-newsletter-row align-items-center">
						<div class="col-lg-5 mb-2 mb-lg-0">
							<p class="fm-newsletter-text mb-0">
								<strong>Restez informé !</strong> Recevez nos offres et actualités.
							</p>
						</div>
						<div class="col-lg-7">
							<div class="fm-newsletter-form">
								<div class="input-group">
									<input type="email" class="form-control" placeholder="Votre adresse email"/>
									<button class="fm-btn-newsletter" type="button">S'inscrire</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</xpath>
	</template>

	<template id="footer_copyright_company_name_inherited_portal" inherit_id="portal.frontend_layout" active="True">
		<xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
			<div class="fm-copyright-inner d-flex flex-column flex-sm-row align-items-center justify-content-between w-100">
				<div class="fm-payment-icons mb-2 mb-sm-0">
					<img src="/website_freemoov/static/src/img/payment_icons.png"
						alt="Modes de paiement" loading="lazy"/>
				</div>
				<span class="fm-copyright-text">
					Copyright © Freemoov SRL | Tous droits réservés | Boulevard de la Sauvenière 136B, 4000 Liège, Belgique
				</span>
			</div>
		</xpath>
	</template>
</odoo>
