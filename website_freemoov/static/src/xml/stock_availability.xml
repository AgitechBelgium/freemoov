<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="website_sale_stock.product_availability"
       t-inherit="website_sale_stock.product_availability"
       t-inherit-mode="extension">
        <xpath expr="//div[@id='out_of_stock_message']" position="replace">
            <div id="out_of_stock_message">
                <p class="label mb-1">
                    <span class="o_ribbon bg-danger o_ribbon_left"/>
                    <span>Rupture de stock</span>
                </p>
                <p class="label mb-1" t-if="product_id and product_id.is_available_trial">
                    <span class="o_ribbon bg-primary o_ribbon_left"/>
                    <span>Disponible à l'essai</span>
                </p>
            </div>
        </xpath>
    </t>

</templates>
