<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_qty_delivered_reconcile_form" model="ir.ui.view">
        <field name="name">freemoov.qty.delivered.reconcile.form</field>
        <field name="model">freemoov.qty.delivered.reconcile.wizard</field>
        <field name="arch" type="xml">
            <form string="POS-FSM Qty Delivered Reconciliation">
                <group>
                    <field name="mode" widget="radio"/>
                </group>
                <group string="Results" invisible="not affected_count">
                    <field name="affected_count"/>
                    <field name="fixed_count"/>
                    <field name="skipped_count"/>
                    <field name="report_file" filename="report_filename"/>
                    <field name="report_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_run" type="object" string="Run" class="btn-primary"/>
                    <button special="cancel" string="Close"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_qty_delivered_reconcile" model="ir.actions.act_window">
        <field name="name">Reconcile Qty Delivered (POS-FSM)</field>
        <field name="res_model">freemoov.qty.delivered.reconcile.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
