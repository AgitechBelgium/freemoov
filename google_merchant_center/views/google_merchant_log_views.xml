<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="google_merchant_log_view_tree" model="ir.ui.view">
        <field name="name">google.merchant.log.tree</field>
        <field name="model">google.merchant.log</field>
        <field name="arch" type="xml">
            <tree string="GMC Sync Logs" create="0" delete="1" edit="0">
                <field name="create_date"/>
                <field name="product_id"/>
                <field name="operation"/>
                <field name="status"/>
                <field name="error_message"/>
                <field name="gmc_product_id"/>
            </tree>
        </field>
    </record>
</odoo>
