<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_google_merchant" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.google.merchant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Google Merchant Center" data-key="google_merchant_center" string="Google Merchant Center">
                    <h2>Google Merchant Center</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="gmc_sync_enabled"/>
                                <field name="gmc_sync_enabled"/>
                                <div class="text-muted">Enable product sync to Google Merchant Center</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="gmc_dry_run"/>
                                <field name="gmc_dry_run"/>
                                <div class="text-muted">
                                    Dry Run: log product data without sending to Google API.
                                    Disable only when ready for production.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="gmc_merchant_id"/>
                                <field name="gmc_merchant_id" placeholder="5345092695"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="gmc_data_source_id"/>
                                <field name="gmc_data_source_id" placeholder="10624847602"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="gmc_service_account_json"/>
                                <field name="gmc_service_account_filename" invisible="1"/>
                                <field name="gmc_service_account_json" filename="gmc_service_account_filename"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="gmc_feed_label"/>
                                <field name="gmc_feed_label" placeholder="BE"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="gmc_content_language"/>
                                <field name="gmc_content_language" placeholder="fr"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="gmc_base_url"/>
                                <field name="gmc_base_url" placeholder="https://freemoov.com"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="gmc_cron_interval"/>
                                <field name="gmc_cron_interval"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
