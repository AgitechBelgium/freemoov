<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_google_merchant" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.google.merchant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- v17 settings views are structured as <app>/<block>/<setting>;
                 the v16 anchor //div[@data-key='website'] no longer exists and
                 killed the registry on any fresh install of this module. -->
            <xpath expr="//app[@name='website']" position="inside">
                <block title="Google Merchant Center">
                    <setting string="Synchronisation GMC" help="Activer la synchro vers Google Merchant Center">
                        <field name="gmc_sync_enabled"/>
                    </setting>
                    <setting string="Mode test" help="Mode test : les donnees sont loguees sans etre envoyees a Google.">
                        <field name="gmc_dry_run"/>
                    </setting>
                    <setting string="Merchant ID">
                        <field name="gmc_merchant_id" placeholder="5345092695"/>
                    </setting>
                    <setting string="Data source ID">
                        <field name="gmc_data_source_id" placeholder="10624847602"/>
                    </setting>
                    <setting string="Compte de service (JSON)">
                        <field name="gmc_service_account_filename" invisible="1"/>
                        <field name="gmc_service_account_json" filename="gmc_service_account_filename"/>
                    </setting>
                    <setting string="Feed label">
                        <field name="gmc_feed_label" placeholder="BE"/>
                    </setting>
                    <setting string="Langue du contenu">
                        <field name="gmc_content_language" placeholder="fr"/>
                    </setting>
                    <setting string="URL de base">
                        <field name="gmc_base_url" placeholder="https://freemoov.com"/>
                    </setting>
                    <setting string="Intervalle du cron (minutes)">
                        <field name="gmc_cron_interval"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
