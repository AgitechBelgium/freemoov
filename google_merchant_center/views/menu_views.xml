<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_google_merchant_log" model="ir.actions.act_window">
        <field name="name">GMC Sync Logs</field>
        <field name="res_model">google.merchant.log</field>
        <field name="view_mode">tree</field>
        <field name="context">{'search_default_status_error': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No sync logs yet.</p>
            <p>Logs are created when products are synced to Google Merchant Center (automatically or manually).</p>
        </field>
    </record>
    <record id="action_google_merchant_sync_wizard" model="ir.actions.act_window">
        <field name="name">Sync to Google Merchant Center</field>
        <field name="res_model">google.merchant.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_google_merchant_center_root"
              name="Google Merchant Center"
              parent="website_sale.menu_catalog"
              sequence="50"/>
    <menuitem id="menu_google_merchant_log"
              name="Sync Logs"
              parent="google_merchant_center.menu_google_merchant_center_root"
              action="action_google_merchant_log"
              sequence="10"/>
    <menuitem id="menu_google_merchant_sync_wizard"
              name="Sync Now"
              parent="google_merchant_center.menu_google_merchant_center_root"
              action="action_google_merchant_sync_wizard"
              sequence="5"/>
</odoo>
